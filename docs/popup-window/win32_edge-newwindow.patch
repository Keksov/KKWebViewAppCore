+// ---------------------------------------------------------------------------
+// AppCore patch (KKMindWave panel-window, owner req. 2026-07-13): handle
+// NewWindowRequested so window.open() popups get a PLAIN native window (title
+// bar only) instead of WebView2's default popup with its browser address bar.
+// The popup hosts a controller created from the SAME environment (same
+// profile & browser process), so the opener<->popup web platform
+// (BroadcastChannel, localStorage, window.close()) behaves exactly like the
+// default popup did.
+// ---------------------------------------------------------------------------
+
+// Adapter for popup events that share the (ICoreWebView2*, IUnknown*) Invoke
+// signature (DocumentTitleChanged / WindowCloseRequested).
+template <typename THandler>
+class webview2_popup_event_handler final : public THandler {
+public:
+  webview2_popup_event_handler(REFIID iid, std::function<void()> cb)
+      : m_iid(iid), m_cb(cb) {}
+
+  webview2_popup_event_handler(const webview2_popup_event_handler &) = delete;
+  webview2_popup_event_handler &
+  operator=(const webview2_popup_event_handler &) = delete;
+
+  ULONG STDMETHODCALLTYPE AddRef() { return ++m_ref_count; }
+  ULONG STDMETHODCALLTYPE Release() {
+    if (m_ref_count > 1) {
+      return --m_ref_count;
+    }
+    delete this;
+    return 0;
+  }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, LPVOID *ppv) {
+    if (!ppv) {
+      return E_POINTER;
+    }
+    if (IsEqualIID(riid, m_iid) || IsEqualIID(riid, IID_IUnknown)) {
+      *ppv = this;
+      AddRef();
+      return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
+  HRESULT STDMETHODCALLTYPE Invoke(ICoreWebView2 * /*sender*/,
+                                   IUnknown * /*args*/) {
+    m_cb();
+    return S_OK;
+  }
+
+private:
+  IID m_iid;
+  std::function<void()> m_cb;
+  std::atomic<ULONG> m_ref_count{1};
+};
+
+// AppCore patch (translab detached panel, owner bug 2026-10-15): a NAMED popup
+// (window.open(url, 'tl-panel-orig', ...)) remembers its own NATIVE placement
+// and reopens there, ignoring the features left/top/width/height.
+// Why not the features: the page persists window.screenX/innerWidth in
+// Chromium DIPs, while this (Per-Monitor-V2) process places windows in physical
+// pixels. With mixed scaling (primary 3072px @125%, second monitor at physical
+// x=3072 @100%) the second monitor starts at DIP x=2458, so a window saved
+// there reopened at physical x=2458 — straddling both monitors. A maximized
+// state cannot travel through window.open features at all.
+// Stored next to the exe as AppCore.popups (like AppCore.window), otherwise in
+// %TEMP% under a name derived from the exe path:
+//   <name>=<l t r b> <0|1>   rcNormalPosition (workspace coords) + maximized
+class popup_placement_store {
+public:
+  struct entry {
+    RECT normal{};
+    bool maximized{};
+  };
+
+  // Only plain names get a memory; '_blank' / '' / exotic names keep the old
+  // features-driven placement.
+  static bool valid_name(const std::wstring &name) {
+    if (name.empty() || name.size() > 64 || name[0] == L'_') {
+      return false;
+    }
+    for (wchar_t c : name) {
+      bool ok = (c >= L'a' && c <= L'z') || (c >= L'A' && c <= L'Z') ||
+                (c >= L'0' && c <= L'9') || c == L'-' || c == L'_' ||
+                c == L'.';
+      if (!ok) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  static bool load(const std::wstring &name, entry &out) {
+    auto all = read_all();
+    auto it = all.find(narrow(name));
+    if (it == all.end()) {
+      return false;
+    }
+    out = it->second;
+    return true;
+  }
+
+  static void save(const std::wstring &name, const entry &e) {
+    auto all = read_all();
+    all[narrow(name)] = e;
+    std::string text;
+    for (const auto &kv : all) {
+      char line[160];
+      std::snprintf(line, sizeof(line), "%s=%ld %ld %ld %ld %d\n",
+                    kv.first.c_str(), kv.second.normal.left,
+                    kv.second.normal.top, kv.second.normal.right,
+                    kv.second.normal.bottom, kv.second.maximized ? 1 : 0);
+      text += line;
+    }
+    if (!write_file(exe_dir_path(), text)) {
+      write_file(temp_path(), text);
+    }
+  }
+
+  // Workspace coordinates (rcNormalPosition) are screen coordinates shifted by
+  // the primary monitor's taskbar (non-zero only with a left/top taskbar).
+  static POINT workspace_offset() {
+    MONITORINFO mi{};
+    mi.cbSize = sizeof(mi);
+    HMONITOR primary = MonitorFromPoint(POINT{0, 0}, MONITOR_DEFAULTTOPRIMARY);
+    if (!GetMonitorInfoW(primary, &mi)) {
+      return POINT{0, 0};
+    }
+    return POINT{mi.rcWork.left - mi.rcMonitor.left,
+                 mi.rcWork.top - mi.rcMonitor.top};
+  }
+
+  // A remembered rect is reused only while a monitor still shows a grabbable
+  // part of it (a disconnected monitor falls back to the features).
+  static bool on_screen(const RECT &screen_rect) {
+    if (screen_rect.right - screen_rect.left < 100 ||
+        screen_rect.bottom - screen_rect.top < 100) {
+      return false;
+    }
+    HMONITOR mon = MonitorFromRect(&screen_rect, MONITOR_DEFAULTTONULL);
+    MONITORINFO mi{};
+    mi.cbSize = sizeof(mi);
+    if (!mon || !GetMonitorInfoW(mon, &mi)) {
+      return false;
+    }
+    RECT seen{};
+    if (!IntersectRect(&seen, &screen_rect, &mi.rcWork)) {
+      return false;
+    }
+    return seen.right - seen.left >= 120 && seen.bottom - seen.top >= 60;
+  }
+
+private:
+  // valid_name() guarantees ASCII.
+  static std::string narrow(const std::wstring &s) {
+    std::string r;
+    for (wchar_t c : s) {
+      r += static_cast<char>(c);
+    }
+    return r;
+  }
+
+  static std::wstring exe_path() {
+    wchar_t buf[MAX_PATH * 2]{};
+    DWORD n = GetModuleFileNameW(nullptr, buf, MAX_PATH * 2);
+    return std::wstring(buf, n);
+  }
+
+  static std::wstring exe_dir_path() {
+    auto exe = exe_path();
+    auto slash = exe.find_last_of(L"\\/");
+    auto dir = slash == std::wstring::npos ? std::wstring() : exe.substr(0, slash + 1);
+    return dir + L"AppCore.popups";
+  }
+
+  static std::wstring temp_path() {
+    wchar_t buf[MAX_PATH + 1]{};
+    DWORD n = GetTempPathW(MAX_PATH + 1, buf);
+    unsigned long hash = 2166136261UL; // FNV-1a over the lower-cased exe path
+    for (wchar_t c : exe_path()) {
+      hash = (hash ^ static_cast<unsigned long>(towlower(c))) * 16777619UL;
+      hash &= 0xFFFFFFFFUL;
+    }
+    wchar_t suffix[16];
+    std::swprintf(suffix, 16, L"%08lx", hash);
+    return std::wstring(buf, n) + L"AppCore.popups." + suffix;
+  }
+
+  static bool read_file(const std::wstring &path, std::string &out) {
+    FILE *f = _wfopen(path.c_str(), L"rb");
+    if (!f) {
+      return false;
+    }
+    char chunk[4096];
+    size_t got;
+    while ((got = std::fread(chunk, 1, sizeof(chunk), f)) > 0) {
+      out.append(chunk, got);
+    }
+    std::fclose(f);
+    return true;
+  }
+
+  static bool write_file(const std::wstring &path, const std::string &text) {
+    FILE *f = _wfopen(path.c_str(), L"wb");
+    if (!f) {
+      return false;
+    }
+    bool ok = std::fwrite(text.data(), 1, text.size(), f) == text.size();
+    return std::fclose(f) == 0 && ok;
+  }
+
+  static std::map<std::string, entry> read_all() {
+    std::map<std::string, entry> all;
+    std::string text;
+    if (!read_file(exe_dir_path(), text) && !read_file(temp_path(), text)) {
+      return all;
+    }
+    size_t pos = 0;
+    while (pos < text.size()) {
+      size_t eol = text.find('\n', pos);
+      std::string line = text.substr(pos, eol == std::string::npos ? std::string::npos : eol - pos);
+      pos = eol == std::string::npos ? text.size() : eol + 1;
+      size_t eq = line.find('=');
+      if (eq == std::string::npos || eq == 0) {
+        continue;
+      }
+      entry e;
+      long l, t, r, b;
+      int maximized;
+      if (std::sscanf(line.c_str() + eq + 1, "%ld %ld %ld %ld %d", &l, &t, &r, &b,
+                      &maximized) != 5) {
+        continue;
+      }
+      e.normal = RECT{l, t, r, b};
+      e.maximized = maximized != 0;
+      all[line.substr(0, eq)] = e;
+    }
+    return all;
+  }
+};
+
+// One popup window: a bare WS_OVERLAPPEDWINDOW whose client area is filled by
+// a WebView2 controller. The object is COM-refcounted (it is the controller
+// completion handler); the HWND owns one reference and drops it on
+// WM_DESTROY. window.close() from inside the popup maps to DestroyWindow via
+// WindowCloseRequested; document.title drives the native caption.
+class webview2_popup_window
+    : public ICoreWebView2CreateCoreWebView2ControllerCompletedHandler {
+public:
+  // Handles one NewWindowRequested. Returns false if the request could not be
+  // taken over (the caller then leaves it to the default popup).
+  static bool open(ICoreWebView2 *sender,
+                   ICoreWebView2NewWindowRequestedEventArgs *args,
+                   HWND opener) {
+    ICoreWebView2Environment *env = nullptr;
+    ICoreWebView2_2 *sender2 = nullptr;
+    if (FAILED(sender->QueryInterface(IID_ICoreWebView2_2,
+                                      reinterpret_cast<void **>(&sender2))) ||
+        !sender2) {
+      return false;
+    }
+    auto env_res = sender2->get_Environment(&env);
+    sender2->Release();
+    if (FAILED(env_res) || !env) {
+      return false;
+    }
+    auto *popup = new webview2_popup_window(opener);
+    if (!popup->create_window(args)) {
+      env->Release();
+      popup->Release();
+      return false;
+    }
+    auto create_res = env->CreateCoreWebView2Controller(popup->m_hwnd, popup);
+    env->Release();
+    if (FAILED(create_res)) {
+      // The request is already marked handled + deferred: complete it empty
+      // and drop the dead window (nothing opens; extremely unlikely path).
+      DestroyWindow(popup->m_hwnd);
+      return true;
+    }
+    return true;
+  }
+
+  webview2_popup_window(const webview2_popup_window &) = delete;
+  webview2_popup_window &operator=(const webview2_popup_window &) = delete;
+
+  ULONG STDMETHODCALLTYPE AddRef() { return ++m_ref_count; }
+  ULONG STDMETHODCALLTYPE Release() {
+    if (m_ref_count > 1) {
+      return --m_ref_count;
+    }
+    delete this;
+    return 0;
+  }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, LPVOID *ppv) {
+    if (!ppv) {
+      return E_POINTER;
+    }
+    if (IsEqualIID(riid,
+                   IID_ICoreWebView2CreateCoreWebView2ControllerCompletedHandler) ||
+        IsEqualIID(riid, IID_IUnknown)) {
+      *ppv = this;
+      AddRef();
+      return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
+
+  // Controller creation completed.
+  HRESULT STDMETHODCALLTYPE Invoke(HRESULT res,
+                                   ICoreWebView2Controller *controller) {
+    if (FAILED(res) || !controller || !m_hwnd) {
+      complete_request();
+      if (m_hwnd) {
+        DestroyWindow(m_hwnd);
+      }
+      return S_OK;
+    }
+    controller->AddRef();
+    m_controller = controller;
+    controller->get_CoreWebView2(&m_webview);
+    if (m_webview) {
+      ICoreWebView2Settings *settings = nullptr;
+      if (SUCCEEDED(m_webview->get_Settings(&settings)) && settings) {
+        settings->put_IsStatusBarEnabled(FALSE);
+        settings->Release();
+      }
+      ::EventRegistrationToken token;
+      auto *title_handler = new webview2_popup_event_handler<
+          ICoreWebView2DocumentTitleChangedEventHandler>(
+          IID_ICoreWebView2DocumentTitleChangedEventHandler,
+          [this] { update_title(); });
+      m_webview->add_DocumentTitleChanged(title_handler, &token);
+      // On success the runtime holds its own reference; on failure this frees.
+      title_handler->Release();
+      auto *close_handler = new webview2_popup_event_handler<
+          ICoreWebView2WindowCloseRequestedEventHandler>(
+          IID_ICoreWebView2WindowCloseRequestedEventHandler, [this] {
+            if (m_hwnd) {
+              DestroyWindow(m_hwnd);
+            }
+          });
+      m_webview->add_WindowCloseRequested(close_handler, &token);
+      close_handler->Release();
+      if (m_args) {
+        m_args->put_NewWindow(m_webview);
+      }
+    }
+    complete_request();
+    resize_webview();
+    m_controller->put_IsVisible(TRUE);
+    ShowWindow(m_hwnd, m_show_cmd);
+    m_shown = true;
+    UpdateWindow(m_hwnd);
+    m_controller->MoveFocus(COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+    return S_OK;
+  }
+
+private:
+  explicit webview2_popup_window(HWND opener) : m_opener(opener) {}
+  virtual ~webview2_popup_window() = default;
+
+  static const wchar_t *popup_class_name() { return L"appcore_webview_popup"; }
+
+  static void register_window_class(HINSTANCE hInstance) {
+    static bool registered = false;
+    if (registered) {
+      return;
+    }
+    registered = true;
+    WNDCLASSEXW wc{};
+    wc.cbSize = sizeof(WNDCLASSEX);
+    wc.hInstance = hInstance;
+    wc.lpszClassName = popup_class_name();
+    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
+    wc.lpfnWndProc =
+        (WNDPROC)(+[](HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) -> LRESULT {
+          webview2_popup_window *w{};
+          if (msg == WM_NCCREATE) {
+            auto *lpcs{reinterpret_cast<LPCREATESTRUCT>(lp)};
+            w = static_cast<webview2_popup_window *>(lpcs->lpCreateParams);
+            w->m_hwnd = hwnd;
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA,
+                              reinterpret_cast<LONG_PTR>(w));
+            enable_non_client_dpi_scaling_if_needed(hwnd);
+            apply_window_theme(hwnd);
+          } else {
+            w = reinterpret_cast<webview2_popup_window *>(
+                GetWindowLongPtrW(hwnd, GWLP_USERDATA));
+          }
+          if (!w) {
+            return DefWindowProcW(hwnd, msg, wp, lp);
+          }
+          switch (msg) {
+          case WM_SIZE:
+            w->resize_webview();
+            if (!w->m_in_sizemove && wp != SIZE_MINIMIZED) {
+              w->remember_placement(); // maximize/restore, snap
+            }
+            break;
+          case WM_MOVE:
+            if (!w->m_in_sizemove) {
+              w->remember_placement(); // Win+Shift+Arrow and friends
+            }
+            break;
+          case WM_ENTERSIZEMOVE:
+            w->m_in_sizemove = true;
+            break;
+          case WM_EXITSIZEMOVE:
+            w->m_in_sizemove = false;
+            w->remember_placement();
+            break;
+          case WM_CLOSE:
+            DestroyWindow(hwnd);
+            break;
+          case WM_ACTIVATE:
+            if (LOWORD(wp) != WA_INACTIVE && w->m_controller) {
+              w->m_controller->MoveFocus(
+                  COREWEBVIEW2_MOVE_FOCUS_REASON_PROGRAMMATIC);
+            }
+            break;
+          case WM_DESTROY:
+            w->remember_placement();
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+            w->m_hwnd = nullptr;
+            w->cleanup();
+            w->Release(); // the window's reference
+            break;
+          default:
+            return DefWindowProcW(hwnd, msg, wp, lp);
+          }
+          return 0;
+        });
+    RegisterClassExW(&wc);
+  }
+
+  bool create_window(ICoreWebView2NewWindowRequestedEventArgs *args) {
+    HINSTANCE hInstance = GetModuleHandle(nullptr);
+    register_window_class(hInstance);
+
+    // Honor window.open features (best-effort; sizes are content-area px).
+    int left = CW_USEDEFAULT;
+    int top = CW_USEDEFAULT;
+    int width = 900;
+    int height = 600;
+    bool has_position = false;
+    ICoreWebView2WindowFeatures *features = nullptr;
+    if (SUCCEEDED(args->get_WindowFeatures(&features)) && features) {
+      BOOL has{};
+      UINT32 value{};
+      if (SUCCEEDED(features->get_HasSize(&has)) && has) {
+        if (SUCCEEDED(features->get_Width(&value)) && value > 0) {
+          width = static_cast<int>(value);
+        }
+        if (SUCCEEDED(features->get_Height(&value)) && value > 0) {
+          height = static_cast<int>(value);
+        }
+      }
+      if (SUCCEEDED(features->get_HasPosition(&has)) && has) {
+        has_position = true;
+        if (SUCCEEDED(features->get_Left(&value))) {
+          left = static_cast<int>(value);
+        }
+        if (SUCCEEDED(features->get_Top(&value))) {
+          top = static_cast<int>(value);
+        }
+      }
+      features->Release();
+    }
+    RECT frame{0, 0, width, height};
+    AdjustWindowRect(&frame, WS_OVERLAPPEDWINDOW, FALSE);
+
+    // features left/top are the desired CONTENT top-left (what the child persists via
+    // window.screenX/screenY). frame.left/top are the negative non-client margins, so offsetting
+    // by them lands the CONTENT — not the frame — at (left, top). This makes repeated
+    // detach/reopen drift-free: the child reads back exactly the screenX/screenY it saved.
+    int frameX = has_position ? (left + frame.left) : CW_USEDEFAULT;
+    int frameY = has_position ? (top + frame.top) : CW_USEDEFAULT;
+    int frameW = frame.right - frame.left;
+    int frameH = frame.bottom - frame.top;
+
+    // A named popup reopens where it was last left (physical px, maximized
+    // included) — see popup_placement_store.
+    ICoreWebView2NewWindowRequestedEventArgs2 *args2 = nullptr;
+    if (SUCCEEDED(args->QueryInterface(IID_ICoreWebView2NewWindowRequestedEventArgs2,
+                                       reinterpret_cast<void **>(&args2))) &&
+        args2) {
+      LPWSTR name = nullptr;
+      if (SUCCEEDED(args2->get_Name(&name)) && name) {
+        if (popup_placement_store::valid_name(name)) {
+          m_name = name;
+        }
+        CoTaskMemFree(name);
+      }
+      args2->Release();
+    }
+    popup_placement_store::entry saved;
+    if (!m_name.empty() && popup_placement_store::load(m_name, saved)) {
+      POINT off = popup_placement_store::workspace_offset();
+      RECT screen_rect = saved.normal;
+      OffsetRect(&screen_rect, off.x, off.y);
+      if (popup_placement_store::on_screen(screen_rect)) {
+        frameX = screen_rect.left;
+        frameY = screen_rect.top;
+        frameW = screen_rect.right - screen_rect.left;
+        frameH = screen_rect.bottom - screen_rect.top;
+        m_show_cmd = saved.maximized ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL;
+        m_last_saved = saved;
+        m_has_last_saved = true;
+      }
+    }
+
+    CreateWindowExW(0, popup_class_name(), L"", WS_OVERLAPPEDWINDOW, frameX, frameY,
+                    frameW, frameH, nullptr, nullptr, hInstance, this);
+    if (!m_hwnd) {
+      return false;
+    }
+
+    // Inherit the opener's branded icons (AppCore sets them via WM_SETICON).
+    if (m_opener) {
+      auto big = SendMessageW(m_opener, WM_GETICON, ICON_BIG, 0);
+      auto small = SendMessageW(m_opener, WM_GETICON, ICON_SMALL, 0);
+      if (big) {
+        SendMessageW(m_hwnd, WM_SETICON, ICON_BIG, big);
+      }
+      if (small) {
+        SendMessageW(m_hwnd, WM_SETICON, ICON_SMALL, small);
+      }
+    }
+
+    // Take the request over: suppress the default popup and keep the request
+    // alive until our controller is ready to be handed back as NewWindow.
+    args->put_Handled(TRUE);
+    m_args = args;
+    m_args->AddRef();
+    if (FAILED(args->GetDeferral(&m_deferral))) {
+      m_deferral = nullptr;
+    }
+    return true;
+  }
+
+  void complete_request() {
+    if (m_args && m_deferral) {
+      // NewWindow was set by Invoke when the controller came up; completing
+      // without it just cancels the request (default popup stays suppressed).
+    }
+    if (m_deferral) {
+      m_deferral->Complete();
+      m_deferral->Release();
+      m_deferral = nullptr;
+    }
+    if (m_args) {
+      m_args->Release();
+      m_args = nullptr;
+    }
+  }
+
+  void cleanup() {
+    complete_request();
+    if (m_controller) {
+      m_controller->Close();
+      m_controller->Release();
+      m_controller = nullptr;
+    }
+    if (m_webview) {
+      m_webview->Release();
+      m_webview = nullptr;
+    }
+  }
+
+  void resize_webview() {
+    if (m_hwnd && m_controller) {
+      RECT bounds{};
+      if (GetClientRect(m_hwnd, &bounds)) {
+        m_controller->put_Bounds(bounds);
+      }
+    }
+  }
+
+  // Captures the settled placement of a named popup (see popup_placement_store).
+  void remember_placement() {
+    if (!m_hwnd || !m_shown || m_name.empty()) {
+      return;
+    }
+    WINDOWPLACEMENT wp{};
+    wp.length = sizeof(wp);
+    if (!GetWindowPlacement(m_hwnd, &wp)) {
+      return;
+    }
+    popup_placement_store::entry e;
+    e.normal = wp.rcNormalPosition;
+    bool iconic = IsIconic(m_hwnd) != FALSE;
+    e.maximized = iconic ? (wp.flags & WPF_RESTORETOMAXIMIZED) != 0
+                         : IsZoomed(m_hwnd) != FALSE;
+    if (e.maximized && !iconic) {
+      // SW_SHOWMAXIMIZED maximizes onto the monitor of the NORMAL rect; after
+      // Win+Shift+Arrow that rect can still sit on the old monitor — pull it
+      // onto the monitor the window is maximized on.
+      POINT off = popup_placement_store::workspace_offset();
+      RECT screen_rect = e.normal;
+      OffsetRect(&screen_rect, off.x, off.y);
+      HMONITOR target = MonitorFromWindow(m_hwnd, MONITOR_DEFAULTTONEAREST);
+      MONITORINFO mi{};
+      mi.cbSize = sizeof(mi);
+      if (MonitorFromRect(&screen_rect, MONITOR_DEFAULTTONEAREST) != target &&
+          GetMonitorInfoW(target, &mi)) {
+        LONG workW = mi.rcWork.right - mi.rcWork.left;
+        LONG workH = mi.rcWork.bottom - mi.rcWork.top;
+        LONG w = (std::min)(screen_rect.right - screen_rect.left, workW);
+        LONG h = (std::min)(screen_rect.bottom - screen_rect.top, workH);
+        LONG x = mi.rcWork.left + (workW - w) / 2;
+        LONG y = mi.rcWork.top + (workH - h) / 2;
+        e.normal = RECT{x - off.x, y - off.y, x + w - off.x, y + h - off.y};
+      }
+    }
+    if (m_has_last_saved && EqualRect(&e.normal, &m_last_saved.normal) &&
+        e.maximized == m_last_saved.maximized) {
+      return;
+    }
+    popup_placement_store::save(m_name, e);
+    m_last_saved = e;
+    m_has_last_saved = true;
+  }
+
+  void update_title() {
+    if (!m_webview || !m_hwnd) {
+      return;
+    }
+    LPWSTR title = nullptr;
+    if (SUCCEEDED(m_webview->get_DocumentTitle(&title)) && title) {
+      SetWindowTextW(m_hwnd, title);
+      CoTaskMemFree(title);
+    }
+  }
+
+  HWND m_opener = nullptr;
+  HWND m_hwnd = nullptr;
+  ICoreWebView2Controller *m_controller = nullptr;
+  ICoreWebView2 *m_webview = nullptr;
+  ICoreWebView2NewWindowRequestedEventArgs *m_args = nullptr;
+  ICoreWebView2Deferral *m_deferral = nullptr;
+  std::wstring m_name;           // window.open target name; '' = no memory
+  int m_show_cmd = SW_SHOW;
+  bool m_shown = false;          // creation-time WM_SIZE/WM_MOVE are not saved
+  bool m_in_sizemove = false;    // drag/resize in progress: save on exit only
+  popup_placement_store::entry m_last_saved;
+  bool m_has_last_saved = false;
+  std::atomic<ULONG> m_ref_count{1};
+};
